// GitHub Codespaces / Dev Container definition.
// Opening the repo in a Codespace gives you a cloud Linux machine with Docker,
// Python and Ansible. Ansible then installs the rest (kubectl, helm, kind, terraform),
// exactly like it would configure a real server. Nothing runs on your laptop.
{
  "name": "devops-taskapp",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    // Runs a Docker daemon INSIDE the codespace: kind, Jenkins, image builds all live here.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8000, 8080, 8081, 8082, 3000, 9090, 9093],
  "portsAttributes": {
    "8000": { "label": "TaskApp (docker compose)" },
    "8080": { "label": "Jenkins" },
    "8081": { "label": "TaskApp (Kubernetes via Traefik)" },
    "8082": { "label": "Argo CD" },
    "3000": { "label": "Grafana" },
    "9090": { "label": "Prometheus" },
    "9093": { "label": "Alertmanager" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "hashicorp.terraform",
        "redhat.ansible",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "redhat.vscode-yaml"
      ]
    }
  }
}
